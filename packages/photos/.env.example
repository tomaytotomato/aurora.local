# home.local / packages/photos / .env
#
# Copy to .env in this directory and fill in.
#
#   cp .env.example .env
#
# See https://immich.app/docs/install/environment-variables

# ---- global ----
TZ=Europe/London

# ---- Immich release pin ----
# 'release' tracks the latest tagged release. Pin to e.g. v1.106.4 for
# reproducibility.
IMMICH_VERSION=release

# ---- library location ----
# Where photo/video originals are stored. Defaults inside the repo
# (../../data/photos/library). Override to point at bulk storage,
# e.g. /mnt/media/photos.
UPLOAD_LOCATION=../../data/photos/library

# ---- database ----
# Long random string. Rotate here means rotate the mounted postgres
# volume too (this is the postgres superuser password).
DB_PASSWORD=

# ---- server secret ----
# Signs JWT session tokens. Generate: openssl rand -hex 32
JWT_SECRET=
