# home.local / packages/photos / caddy.snippet
#
# Imported by packages/core/caddy/Caddyfile via `import` once the
# installer wires it up. Serves both http:// and https:// to match
# the rest of the deployment.

http://photos.{$HOME_DOMAIN} {
	reverse_proxy immich-server:2283
}
https://photos.{$HOME_DOMAIN} {
	tls internal
	reverse_proxy immich-server:2283
}
