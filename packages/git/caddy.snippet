# packages/git — Caddy vhost
# Import from packages/core/caddy/Caddyfile.

http://git.{$DOMAIN} {
	reverse_proxy forgejo:3000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

https://git.{$DOMAIN} {
	tls internal
	# Forgejo web + LFS + git-over-HTTPS + websocket (for the built-in
	# web terminal / live activity streams).
	reverse_proxy forgejo:3000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
	# Large pushes / LFS.
	request_body {
		max_size 2GB
	}
}
