# home.local / packages/git / .env.example
#
# Copy to .env and fill in.

TZ=Europe/London

# ---- Forgejo admin (created on first boot) ----
FORGEJO_ADMIN_USER=admin
FORGEJO_ADMIN_EMAIL=admin@home.local
FORGEJO_ADMIN_PASSWORD=

# ---- CI runner ----
# Obtain from Forgejo UI: Site Administration > Actions > Runners.
# Leave blank on first boot; the runner container will start but stay
# unregistered until you populate this and recreate the container.
FORGEJO_RUNNER_TOKEN=
