# Copy to .env and fill in.
# Every KEY referenced by compose.yml is listed here.

TZ=Europe/London
HOME_DOMAIN=home.local

# ---- Secrets (REQUIRED) --------------------------------------------
# Generate each with:  openssl rand -hex 32
AUTHELIA_JWT_SECRET=
AUTHELIA_SESSION_SECRET=
AUTHELIA_STORAGE_ENCRYPTION_KEY=

# ---- Notifier / SMTP (OPTIONAL) ------------------------------------
# If any SMTP var is unset, Authelia falls back to the filesystem
# notifier (writes email bodies to /data/notification.txt inside the
# container — i.e. data/identity/authelia/notification.txt on the host).
# That's fine for a single-user local-only setup; users can grab
# 2FA-enrolment links from the file.
AUTHELIA_NOTIFIER_SMTP_HOST=
AUTHELIA_NOTIFIER_SMTP_PORT=587
AUTHELIA_NOTIFIER_SMTP_USERNAME=
AUTHELIA_NOTIFIER_SMTP_PASSWORD=
AUTHELIA_NOTIFIER_SMTP_SENDER=authelia@home.local
