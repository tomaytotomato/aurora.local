# aurora.local / Caddyfile
#
# One vhost per service on ${DOMAIN} (default aurora.local).
# Each site serves BOTH http:// and https:// so devices without the
# Caddy root cert installed can still reach dashboards without warnings.
# HTTPS uses Caddy's internal CA; install the root once per device to
# get green padlocks:
#   docker exec -it caddy cat /data/caddy/pki/authorities/local/root.crt
#
# DNS: AdGuard (packages/privacy) is expected to answer *.{$DOMAIN}
# with the LAN IP of this box.

{
	# auto_https disable_redirects: keep http:// listening on :80 without
	# forcing 301 → https. Browsers with a cached HSTS from a previous
	# aurora.local install would otherwise be locked out until they
	# manually cleared HSTS.
	auto_https disable_redirects
	log {
		output file /var/log/caddy/access.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}
}

# Reusable snippet: strip any HSTS the upstream might set, so nothing
# Caddy proxies can lock a browser into https-only. Bruce's Firefox on
# macOS was hitting exactly this after an earlier home.local install.
(no_hsts) {
	header -Strict-Transport-Security
}

# ---- Aurora dashboard (apex) ----------------------------------------
# Aurora IS the landing page: served at the bare domain, plus raw LAN IP
# fallback. Homepage retired in v0.1.
# /caddy-health is a fast-path Caddy answers itself (no upstream trip)
# so the docker healthcheck stays honest during aurora restarts.
http://{$DOMAIN}, http://aurora.local, http://192.168.0.110 {
	import no_hsts
	handle /caddy-health {
		respond "caddy ok" 200 {
			close
		}
	}
	reverse_proxy aurora:8090
}
https://{$DOMAIN}, https://aurora.local {
	tls internal
	import no_hsts
	handle /caddy-health {
		respond "caddy ok" 200 {
			close
		}
	}
	reverse_proxy aurora:8090
}

# ---- Per-app vhosts --------------------------------------------------
# There are none here on purpose. Every app's vhost lives in its own
# packages/<pkg>/caddy.snippet and is materialised into
# /etc/caddy/snippets/ for the packages that are actually enabled (see the
# import at the bottom). Core used to hardcode adguard/sonarr/radarr/...
# here as well, which meant Caddy advertised vhosts for apps that were not
# installed, the dashboard's per-app "vhosts" list disagreed with Caddy,
# and a package that later grew its own snippet collided with core
# ("ambiguous site definition: https://adguard.aurora.local").

# ---- Storage --------------------------------------------------------
# minidlna runs with network_mode: host for UPnP multicast, so it's not
# reachable from the caddy bridge network without UFW carve-outs. Access
# its (minimal) status UI directly at http://<lan-ip>:8200/.

# ---- Per-package snippets -------------------------------------------
# Every enabled package's caddy.snippet is materialised at
# /etc/caddy/snippets/<pkg>.caddy by scripts/up.sh (via lib/render.sh).
# Files are picked up automatically; disabled packages get pruned.
import /etc/caddy/snippets/*.caddy
