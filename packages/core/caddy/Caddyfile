# home.local / Caddyfile
#
# One vhost per service on ${HOME_DOMAIN} (default home.local).
# Each site serves BOTH http:// and https:// so devices without the
# Caddy root cert installed can still reach dashboards without warnings.
# HTTPS uses Caddy's internal CA; install the root once per device to
# get green padlocks:
#   docker exec -it caddy cat /data/caddy/pki/authorities/local/root.crt
#
# DNS: AdGuard (packages/privacy) is expected to answer *.{$HOME_DOMAIN}
# with the LAN IP of this box.

{
	auto_https disable_redirects
	log {
		output file /var/log/caddy/access.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}
}

# ---- Core ------------------------------------------------------------
# Homepage is also the fallback for raw IP / aurora.local so bookmarks
# keep working while AdGuard DNS is being brought online.
http://home.{$HOME_DOMAIN}, http://{$HOME_DOMAIN}, http://aurora.local, http://192.168.0.110 {
	reverse_proxy homepage:3000
}
https://home.{$HOME_DOMAIN}, https://{$HOME_DOMAIN}, https://aurora.local {
	tls internal
	reverse_proxy homepage:3000
}

# ---- Privacy & security ---------------------------------------------
http://adguard.{$HOME_DOMAIN} {
	reverse_proxy adguard:3000
}
https://adguard.{$HOME_DOMAIN} {
	tls internal
	reverse_proxy adguard:3000
}

