# home.local / packages/notes / .env
#
# Copy to .env and fill in.
#   cp .env.example .env

TZ=Europe/London

# ---- SilverBullet basic-auth ----
# SilverBullet has a single-user auth model. Both must be set or the
# server starts unauthenticated (LAN-only + Caddy still fine, but not
# recommended once you punch a hole to the internet).
SB_USER=admin
SB_PASSWORD=
