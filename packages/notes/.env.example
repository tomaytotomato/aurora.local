# aurora.local / packages/notes / .env
#
# Copy to .env and edit if you want standalone auth.
#   cp .env.example .env

TZ=Europe/London

# ---- SilverBullet basic-auth ----
# SilverBullet has a single-user auth model.
#
# Two modes:
#
# 1) SSO enabled (recommended, default). Aurora manages Authelia
#    forward-auth on notes.$DOMAIN and both SB_USER and SB_PASSWORD
#    stay COMMENTED OUT here so SilverBullet runs open internally —
#    Authelia is the only wall. Users sign into Aurora once and click
#    through to Notes without a second login.
#
#    The compose file uses variable pass-through (- SB_USER, no `=`)
#    so when the vars are absent from the environment they're absent
#    from the container. SilverBullet 2.10 treats even an *empty*
#    SB_USER as "auth enabled" — the var must be truly unset, so
#    keep both keys commented out below rather than blanking them.
#
# 2) SSO disabled (standalone). Uncomment SB_USER + SB_PASSWORD below
#    and set real values. SilverBullet enforces HTTP basic auth
#    internally; nobody reaches the notes without knowing these
#    credentials, but you also don't get single-sign-on across the
#    rest of the box.
#SB_USER=admin
#SB_PASSWORD=
