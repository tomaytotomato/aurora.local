# packages/pi/.env — filled in by scripts/rotate-secrets.sh on first up.
# NEVER commit this. Committed file is .env.example (this template).

# Which model provider Pi should use. 'copilot' assumes the operator
# has dropped their GitHub Copilot auth into data/pi/auth/auth.json.
# 'openai' or 'anthropic' uses the corresponding API key below.
PI_MODEL_PROVIDER=copilot

# Optional: direct API-key providers. Leave blank when using Copilot.
# When set, Pi's ModelRuntime picks these up on its next start.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── LibreChat symmetric secrets ─────────────────────────────────────
# LibreChat refuses to boot without these. rotate-secrets.sh generates
# strong values on first install; leaving them blank here fails-closed.
# 32 hex chars each (CREDS_KEY = 32 bytes, CREDS_IV = 16 bytes, JWTs
# arbitrary length).
LIBRECHAT_CREDS_KEY=
LIBRECHAT_CREDS_IV=
LIBRECHAT_JWT_SECRET=
LIBRECHAT_JWT_REFRESH_SECRET=

# ── Mongo root credential for LibreChat's store ─────────────────────
MONGO_INITDB_ROOT_PASSWORD=

# ── Pi image version pin ────────────────────────────────────────────
# Bumped in lock-step with releases; keeps compose off :latest.
PI_SERVER_VERSION=0.1.0
