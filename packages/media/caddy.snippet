# aurora.local / packages/media / caddy vhost fragment
#
# Moved out of packages/core/caddy/Caddyfile, where these lived hardcoded
# whether or not the media package was installed. A vhost belongs to the
# package that ships the container behind it: that is what makes the
# dashboard's per-app address list true, and what gives each app an Open
# button.

# ---- Media automation -----------------------------------------------
http://sonarr.{$DOMAIN} {
	reverse_proxy sonarr:8989
}
https://sonarr.{$DOMAIN} {
	tls internal
	reverse_proxy sonarr:8989
}

http://radarr.{$DOMAIN} {
	reverse_proxy radarr:7878
}
https://radarr.{$DOMAIN} {
	tls internal
	reverse_proxy radarr:7878
}

http://prowlarr.{$DOMAIN} {
	reverse_proxy prowlarr:9696
}
https://prowlarr.{$DOMAIN} {
	tls internal
	reverse_proxy prowlarr:9696
}

http://bazarr.{$DOMAIN} {
	reverse_proxy bazarr:6767
}
https://bazarr.{$DOMAIN} {
	tls internal
	reverse_proxy bazarr:6767
}

http://seerr.{$DOMAIN} {
	reverse_proxy seerr:5055
}
https://seerr.{$DOMAIN} {
	tls internal
	reverse_proxy seerr:5055
}

http://flaresolverr.{$DOMAIN} {
	reverse_proxy flaresolverr:8191
}
https://flaresolverr.{$DOMAIN} {
	tls internal
	reverse_proxy flaresolverr:8191
}

# ---- Debrid + torrent -----------------------------------------------
http://rdt.{$DOMAIN} {
	reverse_proxy rdtclient:6500
}
https://rdt.{$DOMAIN} {
	tls internal
	reverse_proxy rdtclient:6500
}

# qBittorrent + Gluetun vhosts — only reachable when the 'torrent'
# compose profile is enabled (scripts/up.sh --torrent).
# Leaving them commented so re-enabling is a one-line uncomment.
# http://qbit.{$DOMAIN} {
# 	reverse_proxy gluetun:8080
# }
# https://qbit.{$DOMAIN} {
# 	tls internal
# 	reverse_proxy gluetun:8080
# }

