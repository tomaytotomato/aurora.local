# home.local / packages/media / .env
#
# Everything here is optional — the arrs work without any of it, this
# is just for one-off overrides. All the API keys live in
# packages/core/.env (Homepage reads them for widgets).

TZ=Europe/London

# ---- media library root ----
# Where Sonarr/Radarr/qbit etc. see /tv, /movies, /downloads bind mounts
# on the host. Defaults to /home/bruce/media if unset. Override to match
# group_vars/all.yml's media_root.
MEDIA_ROOT=/home/bruce/media
