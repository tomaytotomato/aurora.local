# aurora.local / packages/dashboard / .env
#
# Copy to .env before enabling this package. `scripts/rotate-secrets.sh`
# will complain about any obviously-weak values.

# Version tag for the built image (bumped on release).
AURORA_VERSION=0.1.0

# UID Aurora runs as inside the container. Must own ~/aurora.local on the host.
AURORA_UID=1000

# Session cookie signing secret. MUST be replaced. `openssl rand -hex 32`.
AURORA_SESSION_SECRET=CHANGEME__openssl_rand_hex_32

# Absolute host path to the aurora.local repo (defaults to $HOME/aurora.local).
# Set explicitly if you cloned somewhere else.
# AURORA_REPO_PATH_HOST=/home/bruce/aurora.local
