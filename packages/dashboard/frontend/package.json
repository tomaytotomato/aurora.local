{
  "name": "aurora-dashboard-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aurora — admin plane for aurora.local. Vue 3.5 + Vite 8 + shadcn-vue + Tailwind 4.",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_USE_MOCKS=1 vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run --reporter=basic"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@vueuse/core": "^12.0.0",
    "axios": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "oh-vue-icons": "^1.0.0-rc3",
    "pinia": "^2.3.0",
    "reka-ui": "^2.0.0",
    "tailwind-merge": "^2.5.4",
    "uplot": "^1.6.31",
    "uplot-vue": "^1.1.4",
    "vue": "^3.5.13",
    "vue-i18n": "^10.0.5",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "msw": "^2.7.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.1.10"
  }
}
