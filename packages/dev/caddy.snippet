# packages/dev — Caddy vhost
# Import from packages/core/caddy/Caddyfile.

http://code.{$DOMAIN} {
	reverse_proxy code-server:8443
}

https://code.{$DOMAIN} {
	tls internal
	# code-server needs websockets and long-lived connections.
	reverse_proxy code-server:8443 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
