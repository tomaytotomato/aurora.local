# aurora.local / packages/dev/pins.env.example
#
# Curated, human-reviewed image pins — the ".example" suffix mirrors the
# existing .env / .env.example convention (see .gitignore): the real
# packages/dev/pins.env is gitignored (generated by `scripts/pin.sh
# --refresh`/`--apply`, host-local), so committed curated recommendations
# live here. Copy or merge into packages/dev/pins.env to adopt.
#
# Every pin below is curated and human-reviewed.
#
# Once adopted as pins.env, this is consumed by scripts/lib/render.sh
# render_pins() into the environment before `docker compose up`. It only
# takes effect in compose.yml image: lines after `scripts/pin.sh --apply`
# has rewritten them to ${IMAGE_<SVC>} — that has NOT been run.
# compose.yml is untouched by this work.
#
# Format: repo:tag@sha256:digest.
#
# Digests obtained with:
#   docker buildx imagetools inspect --format '{{.Manifest.Digest}}' <ref>

# lscr.io/linuxserver/code-server — stable tag 4.132.0, pushed 5 days
# before this check (2026-08-15) — fresh, but this is LinuxServer's real
# stable channel (not develop/nightly), see the general note in
# packages/media/pins.env.example about this stack's normal release
# cadence. Multi-arch: linux/amd64, linux/arm/v7, linux/arm64 —
# confirmed.
IMAGE_CODE_SERVER=lscr.io/linuxserver/code-server:4.132.0@sha256:0a3087964a72abe79e4a7d26ad2ef20e0c19e5fcbe102c208e4a570fff4b8303

# docker.io/library/postgres — same research as packages/documents;
# latest 16.x patch is 16.15-alpine3.24. Multi-arch: linux/386,
# linux/amd64, linux/arm/v6, linux/arm/v7, linux/arm64/v8,
# linux/ppc64le, linux/s390x — confirmed. Checked 2026-08-15.
IMAGE_POSTGRES=postgres:16.15-alpine@sha256:ab5c955e9e57ae9879d4411ab49a912be9d162455676f7bf56e951b11ac73785

# docker.io/library/redis — same research as packages/documents; latest
# 7.x patch is 7.4.10-alpine. See that file's note on Redis Ltd's
# RSALv2/SSPLv1 licence change from 7.4 onward and the redis-8-is-now-
# "latest" situation upstream — staying on `7` (as compose.yml already
# does) is unaffected by this pin. Multi-arch: linux/386, linux/amd64,
# linux/arm/v6, linux/arm/v7, linux/arm64/v8, linux/ppc64le,
# linux/riscv64, linux/s390x — confirmed. Checked 2026-08-15.
IMAGE_REDIS=redis:7.4.10-alpine@sha256:e7723ff73d963f5cc6d9c4643ea3d989527a402a319239054e9472a7fb9219a2
