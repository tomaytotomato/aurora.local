# aurora.local / packages/mail / caddy.snippet
#
# Only the webmail is fronted by Caddy. SMTP/IMAP are raw TCP on their
# own host ports (see compose.yml) and never touch the HTTP proxy.

http://mail.{$DOMAIN} {
	reverse_proxy roundcube:80
}
https://mail.{$DOMAIN} {
	tls internal
	reverse_proxy roundcube:80
}
