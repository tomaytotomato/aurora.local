# home.local / packages/documents / caddy.snippet

http://paperless.{$HOME_DOMAIN} {
	reverse_proxy paperless:8000
}
https://paperless.{$HOME_DOMAIN} {
	tls internal
	reverse_proxy paperless:8000
}

http://pdf.{$HOME_DOMAIN} {
	reverse_proxy stirling-pdf:8080
}
https://pdf.{$HOME_DOMAIN} {
	tls internal
	reverse_proxy stirling-pdf:8080
}
