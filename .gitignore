# ---- secrets ----
.env
.env.*
!.env.example
*.key
*.pem
credentials.yaml

# ---- runtime state ----
# Per-service config/data dirs, bind-mounted into containers.
# These are stateful and NEVER go into git.
data/
packages/*/data/
packages/*/*/data/

# Logs written by containers. Scoped to the runtime trees deliberately:
# a bare `**/logs/` also ignored the repo's own root logs/ directory, so
# anything newly added there never appeared in git status at all. The 11
# files tracked in it survive only because they were indexed before that
# rule landed.
data/**/logs/
packages/*/data/**/logs/
*.log

# ---- installer state ----
# Written by bootstrap.sh; records which packages are enabled on this host.
.state.yml
# Fixture exception: the fake-repo test resources ship a canned
# .state.yml so PackagesServiceTests exercises the enabled[] wire
# end-to-end. Not a real installation state; safe to check in.
!packages/dashboard/backend/src/test/resources/fake-repo/.state.yml

# ---- ansible ----
*.retry
inventory.ini
!inventory.example.ini
group_vars/all.yml
!group_vars/all.example.yml
group_vars/host_vars/
.vault_pass

# ---- identity runtime ----
# users_database.yml holds real password hashes.
packages/identity/authelia/users_database.yml

# ---- pinned image digests ----
# Written by scripts/pin.sh --apply; sourced by scripts/lib/render.sh.
packages/*/pins.env

# ---- disks state ----
# Written on a timer by host/roles/smartd + host/roles/snapraid; read by
# DisksService. Real host output, never checked in.
packages/dashboard/state/

# ---- misc ----
# ansible-galaxy scratch. Untracked and unignored until now, which also
# meant dev/testbed/up.sh copied it into the VM on every sync.
.ansible/
.DS_Store
*.swp
*~
.idea/
.vscode/

# pi-subagents scratch
.pi-subagents/

# Agent worktrees are created inside the repo and would otherwise show up
# as untracked, one bad `git add .` away from being committed.
.claude/

# ---- root npm scripts ----
# The root package.json has no dependencies, so an install here produces
# nothing worth keeping. Ignored so a stray `npm install` at the root does
# not leave untracked clutter behind.
/node_modules/
/package-lock.json

# ---- aurora dashboard E2E ----
packages/dashboard/e2e/node_modules/
packages/dashboard/e2e/test-results/
packages/dashboard/e2e/playwright-report/
/tmp/aurora-e2e-state
:memory:*
