{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aurora.local/schema/manifest.schema.json",
  "title": "aurora.local package manifest",
  "description": "Schema for packages/<name>/manifest.yml. See docs/PACKAGE_CONTRACT.md.",
  "type": "object",
  "required": ["name", "title", "description", "category", "depends_on"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Package identifier; must match the directory name."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "enum": [
        "core", "privacy", "media", "storage", "monitoring",
        "productivity", "dev", "ai", "identity", "home-automation",
        "backup"
      ]
    },
    "depends_on": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
      "uniqueItems": true
    },
    "recommends": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
      "uniqueItems": true
    },
    "variant_group": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Packages sharing this label are interchangeable alternatives for the same job (e.g. notes: silverbullet | memos). The picker groups them and offers them as a choice within a category."
    },
    "variant_default": {
      "type": "boolean",
      "description": "True on the one package in a variant_group that is the recommended default pick."
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description"],
        "properties": {
          "description": { "type": "string" },
          "requires_packages": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          }
        }
      }
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["port", "proto", "description"],
        "additionalProperties": false,
        "properties": {
          "port":        { "type": "integer", "minimum": 1, "maximum": 65535 },
          "proto":       { "type": "string", "enum": ["tcp", "udp"] },
          "description": { "type": "string" },
          "profile":     { "type": "string" }
        }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_ram_mb":  { "type": "integer", "minimum": 0 },
        "min_disk_gb": { "type": "integer", "minimum": 0 },
        "start_budget_seconds": {
          "type": "integer",
          "minimum": 0,
          "description": "How long the launcher waits for this stack to come up before reporting a failure. Bigger stacks (media) need a generous budget."
        },
        "host_roles":  {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "required_env": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "probe": {
      "type": "object",
      "description": "How the control plane checks whether the package is up. Shape varies by kind (docker | http_json | smb); validated loosely on purpose.",
      "additionalProperties": true
    },
    "subpackages": {
      "type": "array",
      "description": "User-facing children shown under the package's row on the dashboard, each with its own status probe.",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "warnings": {
      "type": "array",
      "description": "Pre-install advisories evaluated against the host resource snapshot.",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "post_install_notes": { "type": "string" }
  }
}
